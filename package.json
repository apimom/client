{
  "name": "@apimom/client",
  "version": "0.1.0",
  "description": "TypeScript client SDK for API Mom — unified egress for Cloudflare Workers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./platform": {
      "import": "./dist/platform.js",
      "types": "./dist/platform.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "api",
    "sdk",
    "egress"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apimom/client.git"
  },
  "packageManager": "pnpm@9.0.0"
}
